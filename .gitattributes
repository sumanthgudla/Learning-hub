# Normalize line endings for cross-platform compatibility
* text=auto eol=lf

# Keep Windows batch files as CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Mark binary files explicitly
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.numbers binary
*.zip binary
*.docx binary
*.pptx binary
