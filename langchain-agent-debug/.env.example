# Copy to .env and set your OpenAI or Azure OpenAI credentials

# For OpenAI (non-Azure):
OPENAI_API_KEY=sk-REPLACE_ME

# For Azure OpenAI (set USE_AZURE=true or set AZURE_OPENAI_API_BASE):
# Example:
# AZURE_OPENAI_API_BASE=https://my-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=REPLACE_ME
# AZURE_DEPLOYMENT_NAME=my-deployment
# You can also set USE_AZURE=true to prefer Azure when present
USE_AZURE=false
